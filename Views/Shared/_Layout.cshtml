
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - High School Support System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HighSchoolSupportSystem.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm fixed-top">
            <div class="container-fluid">

                <a class="navbar-brand d-flex align-items-center"
                   asp-controller="Home"
                   asp-action="Index">
                    <img src="~/images/Logo.jpg"
                         alt="Vertex Technical High School Logo"
                         height="50"
                         class="me-2" />

                    <span class="fw-bold">High School Support System</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="about">About</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="services">Services</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Students"
                               asp-action="Index">Students</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Teachers"
                               asp-action="Index">Teachers</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle"
                               href="#"
                               id="tutorsDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Tutors
                            </a>

                            <ul class="dropdown-menu" aria-labelledby="tutorsDropdown">
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Tutors"
                                       asp-action="Index">All Tutors</a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="StudentTutors"
                                       asp-action="Index">Student Tutors</a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="ExternalTutors"
                                       asp-action="Index">External Tutors</a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Subjects"
                               asp-action="Index">Subjects</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle"
                               href="#"
                               id="supportDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Academic Support
                            </a>

                            <ul class="dropdown-menu" aria-labelledby="supportDropdown">
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="SupportRequests"
                                       asp-action="Index">Support Requests</a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="TutorAssignments"
                                       asp-action="Index">Tutor Assignments</a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="StudentSubjects"
                                       asp-action="Index">Student Subjects</a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Login">Login</a>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-primary ms-lg-2 mt-2 mt-lg-0"
                               asp-controller="Account"
                               asp-action="Register">Register</a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="border-top bg-light text-muted mt-5 py-4">
        <div class="container text-center">

            <h5 class="text-dark">High School Support System</h5>

            <p class="mb-2">
                Connecting learners with the academic support they need.
            </p>

            <p class="mb-1">
                <strong>Vertex Technical High School</strong>
            </p>

            <p class="mb-2">
                Johannesburg, Gauteng | School Code: VTHS001
            </p>

            <p class="mb-0">
                &copy; 2026 - High School Support System |
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </p>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
